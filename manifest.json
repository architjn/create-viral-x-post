{
  "manifest_version": 3,
  "name": "Viral X Post Enhancer",
  "version": "1.0.1",
  "description": "Enhances your X posts to increase virality based on data from existing viral posts",
  "icons": {
    "16": "images/icons/icon16.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Viral X Post Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icons/icon16.png",
      "48": "images/icons/icon48.png",
      "128": "images/icons/icon128.png"
    }
  }
}
